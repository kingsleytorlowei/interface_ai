{
  "schema_version": "1",
  "id": "corebank.member.lookup_balance",
  "version": "0.1.0",
  "status": "draft",
  "description": "Look up a member by member number and read their name and Share Savings balance.",
  "app": {
    "app_id": "corebank",
    "surface": "web",
    "compat": "*"
  },
  "risk": "reversible",
  "entry": {
    "url": "{{env.base_url}}/main.html",
    "requires_session": true
  },
  "inputs": {
    "member_id": {
      "type": "string",
      "description": "5-digit member number",
      "sensitivity": "pii",
      "pattern": "^\\d{5}$",
      "enum": null
    }
  },
  "outputs": {
    "member_name": {
      "type": "string",
      "description": "The member's full name",
      "sensitivity": "pii"
    },
    "share_savings_balance": {
      "type": "money",
      "description": "Balance of the member's Share Savings account",
      "sensitivity": "confidential"
    }
  },
  "outcomes": {
    "success": {
      "description": "Member found; summary shows Name and accounts table. Read name from the 'Name:' value cell and the balance from the row whose Description is 'Share Savings'.",
      "when_state": "member_detail"
    },
    "no_results": {
      "description": "Search ran but no member exists with the given member number; no name/balance to extract.",
      "when_state": "no_results"
    },
    "invalid_member_number": {
      "description": "App-side validation rejected the member number (e.g. not 5 digits / non-numeric); search form redisplayed with an error.",
      "when_state": "invalid_member_number"
    },
    "access_denied": {
      "description": "Teller lacks permission to view this (restricted) member; details cannot be read.",
      "when_state": "access_denied"
    },
    "member_alert_needs_person": {
      "description": "A member alert interstitial appears after search requiring a person to read and confirm identity; replay must hand off to a human, then continue to member_detail.",
      "when_state": "member_detail"
    },
    "system_error": {
      "description": "Application error page (fatal) during search; flow cannot complete and must be retried later.",
      "when_state": "member_search"
    }
  },
  "targets": {
    "member_id_field": {
      "frame": [
        {
          "name": "content",
          "title": null,
          "url_contains": null
        }
      ],
      "strategies": [
        {
          "by": "near",
          "text": "Member ID",
          "direction": "right",
          "role": "textbox"
        },
        {
          "by": "css",
          "selector": "input[name=\"mbrno\"]"
        }
      ],
      "fingerprint": {
        "role": "textbox",
        "name": null,
        "tag": "input"
      }
    },
    "search_button": {
      "frame": [
        {
          "name": "content",
          "title": null,
          "url_contains": null
        }
      ],
      "strategies": [
        {
          "by": "role",
          "role": "button",
          "name": "Search",
          "exact": true
        },
        {
          "by": "near",
          "text": "Member ID",
          "direction": "right",
          "role": "button"
        }
      ],
      "fingerprint": {
        "role": "button",
        "name": "Search",
        "tag": "input"
      }
    },
    "member_name": {
      "frame": [
        {
          "name": "content",
          "title": null,
          "url_contains": null
        }
      ],
      "strategies": [
        {
          "by": "near",
          "text": "Name:",
          "direction": "right",
          "role": "cell"
        }
      ],
      "fingerprint": {
        "role": "cell",
        "name": null,
        "tag": "td"
      }
    },
    "share_savings_balance": {
      "frame": [
        {
          "name": "content",
          "title": null,
          "url_contains": null
        }
      ],
      "strategies": [
        {
          "by": "table_cell",
          "row_has_text": "Share Savings",
          "column": "Balance"
        }
      ],
      "fingerprint": {
        "role": "cell",
        "name": null,
        "tag": "td"
      }
    }
  },
  "steps": [
    {
      "id": "fill_member_id_field",
      "intent": "Enter the member number to search",
      "action": {
        "kind": "fill",
        "target": "member_id_field",
        "value": "{{inputs.member_id}}"
      },
      "risk": "read_only",
      "expect": {
        "state": "member_search",
        "timeout_ms": 10000
      }
    },
    {
      "id": "click_search_button",
      "intent": "Run the member search",
      "action": {
        "kind": "click",
        "target": "search_button"
      },
      "risk": "reversible",
      "expect": {
        "state": "member_detail",
        "timeout_ms": 10000
      }
    },
    {
      "id": "extract_member_name",
      "intent": "Read the member's full name",
      "action": {
        "kind": "extract",
        "target": "member_name",
        "into": "member_name"
      },
      "risk": "read_only",
      "expect": {
        "state": "member_detail",
        "timeout_ms": 10000
      }
    },
    {
      "id": "extract_share_savings_balance",
      "intent": "Read the Share Savings account balance",
      "action": {
        "kind": "extract",
        "target": "share_savings_balance",
        "into": "share_savings_balance"
      },
      "risk": "read_only",
      "expect": {
        "state": "member_detail",
        "timeout_ms": 10000
      }
    }
  ],
  "success": {
    "state": "member_detail",
    "outputs_present": [
      "member_name",
      "share_savings_balance"
    ]
  },
  "provenance": {
    "run_id": "20260923T191821Z-91a1a6",
    "model": "claude-opus-5",
    "recorded_at": "2026-09-23T19:19:20.615640Z",
    "reviewed_by": null
  }
}
