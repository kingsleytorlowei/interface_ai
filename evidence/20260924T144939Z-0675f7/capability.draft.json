{
  "schema_version": "1",
  "id": "corebank.subaccount.prepare",
  "version": "0.1.0",
  "status": "draft",
  "description": "Open a new sub-account for this member and reach the review (confirmation) screen, then read back the account type and initial deposit shown there. Do not confirm.",
  "app": {
    "app_id": "corebank",
    "surface": "web",
    "compat": "*"
  },
  "risk": "reversible",
  "entry": {
    "url": "{{env.base_url}}/main.html",
    "requires_session": true
  },
  "inputs": {
    "member_id": {
      "type": "string",
      "description": "5-digit member number",
      "sensitivity": "pii",
      "pattern": "^\\d{5}$",
      "enum": null
    },
    "account_type": {
      "type": "string",
      "description": "Sub-account product",
      "sensitivity": "internal",
      "pattern": null,
      "enum": [
        "Money Market",
        "Holiday Club",
        "Share Certificate"
      ]
    },
    "initial_deposit": {
      "type": "money",
      "description": "Opening deposit in USD",
      "sensitivity": "confidential",
      "pattern": null,
      "enum": null
    }
  },
  "outputs": {
    "account_type": {
      "type": "string",
      "description": "Account type as shown on the review screen",
      "sensitivity": "internal"
    },
    "initial_deposit": {
      "type": "money",
      "description": "Initial deposit as shown on the review screen",
      "sensitivity": "confidential"
    }
  },
  "outcomes": {
    "no_such_member": {
      "description": "Search ran but no member exists with the given member number.",
      "when_state": "no_results"
    },
    "invalid_member_number": {
      "description": "The member number failed app-side validation (e.g. not 5 digits).",
      "when_state": "invalid_member_number"
    },
    "access_denied": {
      "description": "Teller lacks permission to view/act on this member (restricted account).",
      "when_state": "access_denied"
    },
    "subaccount_values_rejected": {
      "description": "The sub-account form rejected the account type / initial deposit values (e.g. deposit below product minimum).",
      "when_state": "subacct_invalid"
    }
  },
  "targets": {
    "member_id_field": {
      "frame": [
        {
          "name": "content",
          "title": null,
          "url_contains": null
        }
      ],
      "strategies": [
        {
          "by": "near",
          "text": "Member ID",
          "direction": "right",
          "role": "textbox"
        },
        {
          "by": "css",
          "selector": "input[name=\"mbrno\"]"
        }
      ],
      "fingerprint": {
        "role": "textbox",
        "name": null,
        "tag": "input"
      }
    },
    "search_button": {
      "frame": [
        {
          "name": "content",
          "title": null,
          "url_contains": null
        }
      ],
      "strategies": [
        {
          "by": "role",
          "role": "button",
          "name": "Search",
          "exact": true
        },
        {
          "by": "near",
          "text": "Member ID",
          "direction": "right",
          "role": "button"
        }
      ],
      "fingerprint": {
        "role": "button",
        "name": "Search",
        "tag": "input"
      }
    },
    "open_subaccount_link": {
      "frame": [
        {
          "name": "content",
          "title": null,
          "url_contains": null
        }
      ],
      "strategies": [
        {
          "by": "role",
          "role": "link",
          "name": "Open Sub-Account",
          "exact": true
        }
      ],
      "fingerprint": {
        "role": "link",
        "name": "Open Sub-Account",
        "tag": "a"
      }
    },
    "account_type_select": {
      "frame": [
        {
          "name": "content",
          "title": null,
          "url_contains": null
        }
      ],
      "strategies": [
        {
          "by": "near",
          "text": "Account Type",
          "direction": "right",
          "role": "combobox"
        },
        {
          "by": "css",
          "selector": "select[name=\"accttype\"]"
        }
      ],
      "fingerprint": {
        "role": "combobox",
        "name": null,
        "tag": "select"
      }
    },
    "initial_deposit_field": {
      "frame": [
        {
          "name": "content",
          "title": null,
          "url_contains": null
        }
      ],
      "strategies": [
        {
          "by": "near",
          "text": "Initial Deposit",
          "direction": "right",
          "role": "textbox"
        },
        {
          "by": "css",
          "selector": "input[name=\"initdep\"]"
        }
      ],
      "fingerprint": {
        "role": "textbox",
        "name": null,
        "tag": "input"
      }
    },
    "continue_button": {
      "frame": [
        {
          "name": "content",
          "title": null,
          "url_contains": null
        }
      ],
      "strategies": [
        {
          "by": "role",
          "role": "button",
          "name": "Continue",
          "exact": true
        },
        {
          "by": "near",
          "text": "OPEN SUB-ACCOUNT \u2014 Jane Q. Sample",
          "direction": "below",
          "role": "button"
        }
      ],
      "fingerprint": {
        "role": "button",
        "name": "Continue",
        "tag": "input"
      }
    },
    "account_type": {
      "frame": [
        {
          "name": "content",
          "title": null,
          "url_contains": null
        }
      ],
      "strategies": [
        {
          "by": "near",
          "text": "Account Type",
          "direction": "right",
          "role": "cell"
        }
      ],
      "fingerprint": {
        "role": "cell",
        "name": null,
        "tag": "td"
      }
    },
    "initial_deposit": {
      "frame": [
        {
          "name": "content",
          "title": null,
