        }
      ],
      "strategies": [
        {
          "by": "near",
          "text": "Initial Deposit",
          "direction": "right",
          "role": "cell"
        }
      ],
      "fingerprint": {
        "role": "cell",
        "name": null,
        "tag": "td"
      }
    }
  },
  "steps": [
    {
      "id": "fill_member_id_field",
      "intent": "Enter the member number to search",
      "action": {
        "kind": "fill",
        "target": "member_id_field",
        "value": "{{inputs.member_id}}"
      },
      "risk": "read_only",
      "expect": {
        "state": "member_search",
        "timeout_ms": 10000
      }
    },
    {
      "id": "click_search_button",
      "intent": "Run the member search",
      "action": {
        "kind": "click",
        "target": "search_button"
      },
      "risk": "reversible",
      "expect": {
        "state": "member_detail",
        "timeout_ms": 10000
      }
    },
    {
      "id": "click_open_subaccount_link",
      "intent": "Open the sub-account entry form",
      "action": {
        "kind": "click",
        "target": "open_subaccount_link"
      },
      "risk": "reversible",
      "expect": {
        "state": "subacct_form",
        "timeout_ms": 10000
      }
    },
    {
      "id": "select_account_type_select",
      "intent": "Choose the sub-account product",
      "action": {
        "kind": "select",
        "target": "account_type_select",
        "option": "{{inputs.account_type}}"
      },
      "risk": "read_only",
      "expect": {
        "state": "subacct_form",
        "timeout_ms": 10000
      }
    },
    {
      "id": "fill_initial_deposit_field",
      "intent": "Enter the opening deposit amount",
      "action": {
        "kind": "fill",
        "target": "initial_deposit_field",
        "value": "{{inputs.initial_deposit}}"
      },
      "risk": "read_only",
      "expect": {
        "state": "subacct_form",
        "timeout_ms": 10000
      }
    },
    {
      "id": "click_continue_button",
      "intent": "Continue to the review screen",
      "action": {
        "kind": "click",
        "target": "continue_button"
      },
      "risk": "reversible",
      "expect": {
        "state": "subacct_review",
        "timeout_ms": 10000
      }
    },
    {
      "id": "extract_account_type",
      "intent": "Read the account type from the review screen",
      "action": {
        "kind": "extract",
        "target": "account_type",
        "into": "account_type"
      },
      "risk": "read_only",
      "expect": {
        "state": "subacct_review",
        "timeout_ms": 10000
      }
    },
    {
      "id": "extract_initial_deposit",
      "intent": "Read the initial deposit from the review screen",
      "action": {
        "kind": "extract",
        "target": "initial_deposit",
        "into": "initial_deposit"
      },
      "risk": "read_only",
      "expect": {
        "state": "subacct_review",
        "timeout_ms": 10000
      }
    }
  ],
  "success": {
    "state": "subacct_review",
    "outputs_present": [
      "account_type",
      "initial_deposit"
    ]
  },
  "provenance": {
    "run_id": "20260924T144939Z-0675f7",
